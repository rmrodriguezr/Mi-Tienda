# Configuración de Firebase (Proyecto > Configuración del proyecto > Tus apps > SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (subida de imágenes de productos, plan gratuito, sin tarjeta).
# Dashboard de Cloudinary > Cloud name. Settings > Upload > Upload presets (modo "Unsigned").
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Número de WhatsApp para recibir pedidos.
# Formato: código de país + número, sin "+", sin espacios ni guiones. Ej: 573001234567
VITE_WHATSAPP_NUMBER=
